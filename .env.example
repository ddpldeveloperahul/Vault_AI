# ==========================================
# JobVault AI — Environment Configuration Template
# Copy this file to .env and configure your values.
# ==========================================

DEBUG=True
SECRET_KEY=django-insecure-replace-with-your-secret-key-in-production

# PostgreSQL Database Configuration
DB_NAME=Vault_AI
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# AI OCR & Vision API Credentials
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-if-used

# SMTP Email Configuration (Gmail) - Used for Forgot Password & OTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=faizansari715@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=faizansari715@gmail.com

